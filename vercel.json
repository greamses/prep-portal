{
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "{tts-cache/**,utils/features.js,prep-math/activity/algebra-moves/js/**}"
    }
  },
  "redirects": [
    { "source": "/prep-math/activity/remainder-theorem-workbook", "destination": "/prep-math/activity/algebra-workbook/", "permanent": true },
    { "source": "/prep-math/activity/remainder-theorem-workbook/", "destination": "/prep-math/activity/algebra-workbook/", "permanent": true },
    { "source": "/prep-math/activity/remainder-theorem-workbook/:path*", "destination": "/prep-math/activity/algebra-workbook/", "permanent": true },
    { "source": "/prep-math/activity/two-scales", "destination": "/prep-math/activity/algebra-workbook/", "permanent": true },
    { "source": "/prep-math/activity/two-scales/", "destination": "/prep-math/activity/algebra-workbook/", "permanent": true },
    { "source": "/prep-math/activity/two-scales/:path*", "destination": "/prep-math/activity/algebra-workbook/", "permanent": true },
    { "source": "/prep-math/activity/remainders-workbook", "destination": "/prep-math/activity/maths-workbook/", "permanent": true },
    { "source": "/prep-math/activity/remainders-workbook/", "destination": "/prep-math/activity/maths-workbook/", "permanent": true },
    { "source": "/prep-math/activity/remainders-workbook/:path*", "destination": "/prep-math/activity/maths-workbook/", "permanent": true },
    { "source": "/prep-math/activity/place-value-workbook", "destination": "/prep-math/activity/maths-workbook/", "permanent": true },
    { "source": "/prep-math/activity/place-value-workbook/", "destination": "/prep-math/activity/maths-workbook/", "permanent": true },
    { "source": "/prep-math/activity/place-value-workbook/:path*", "destination": "/prep-math/activity/maths-workbook/", "permanent": true },
    { "source": "/prep-math/drag", "destination": "/prep-math/activity/algebra-moves/", "permanent": true },
    { "source": "/prep-math/drag/", "destination": "/prep-math/activity/algebra-moves/", "permanent": true },
    { "source": "/prep-math/drag/:path*", "destination": "/prep-math/activity/algebra-moves/", "permanent": true },
    { "source": "/home/games/aliens", "destination": "/home/games/", "permanent": true },
    { "source": "/home/games/aliens/", "destination": "/home/games/", "permanent": true },
    { "source": "/home/games/aliens/:path*", "destination": "/home/games/", "permanent": true },
    { "source": "/home/games/maze", "destination": "/home/games/", "permanent": true },
    { "source": "/home/games/maze/", "destination": "/home/games/", "permanent": true },
    { "source": "/home/games/maze/:path*", "destination": "/home/games/", "permanent": true },
    { "source": "/home/games/drone", "destination": "/home/games/", "permanent": true },
    { "source": "/home/games/drone/", "destination": "/home/games/", "permanent": true },
    { "source": "/home/games/drone/:path*", "destination": "/home/games/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/w/:code", "destination": "/writing/index.html" },
    { "source": "/wb/:code", "destination": "/workbook-play/index.html" }
  ],
  "headers": [
    { "source": "/(.*).js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*).mjs", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*).css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(dashboard|partner|activity|admin-cbt|admin-cbt-edit|admin-partners).html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/(admin|w|wb|workbook-play|tools|logo)/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/prep-math/activity/maths-workbook(.*)", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }, { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }] },
    { "source": "/prep-math/activity/geometry-workbook(.*)", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }, { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }] }
  ]
}
