# Local tooling, never part of the site. With outputDirectory "." anything
# uploaded is SERVED — .claude/settings.local.json was publicly readable, and
# .claude (worktrees) was two-thirds of every deployment's size.
.claude
.github
.vscode
.env
.env.*
.firebaserc
.hintrc
docs
scripts
cloudflare
DESIGN.md

# Retired — Algebra Moves replaced it. Kept in git, not deployed.
prep-math/drag

# 3D games taken down to cut Vercel usage. Kept in git, not deployed.
# Basketball (free-throw), chess and the speed cube stay live.
home/games/aliens
home/games/maze
home/games/drone

# Never upload installed packages: the build installs its own, and with outputDirectory "."
# anything uploaded is served.
node_modules

