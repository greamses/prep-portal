{"timeLimit":2400,"questions":[{"question":"Change the number \\(1010_{\\text{two}}\\) to base ten.","options":["\\(40_{\\text{ten}}\\)","\\(14_{\\text{ten}}\\)","\\(18_{\\text{ten}}\\)","\\(10_{\\text{ten}}\\)","\\(36_{\\text{ten}}\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(8 + 0 + 2 + 0 = 10\\)."],"hint":"","image":null,"topic":"Number Bases","type":"objective","section":null},{"question":"The sum of three consecutive odd numbers is \\(105\\). The median of the three numbers is:","options":["\\(15\\)","\\(27\\)","\\(35\\)","\\(47\\)","\\(59\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["The middle number is \\(105 \\div 3 = 35\\)."],"hint":"","image":null,"topic":"Statistics","type":"objective","section":null},{"question":"If the bearing of \\(A\\) from \\(B\\) is \\(35^{\\circ}\\), what is the bearing of \\(B\\) from \\(A\\)?","options":["\\(35^{\\circ}\\)","\\(215^{\\circ}\\)","\\(135^{\\circ}\\)","\\(315^{\\circ}\\)","\\(360^{\\circ}\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["The back bearing is \\(35 + 180 = 215^{\\circ}\\)."],"hint":"","image":null,"topic":"Bearings","type":"objective","section":null},{"question":"Find the diameter of a circle whose circumference is \\(22\\text{ cm}\\).","options":["\\(44\\text{ cm}\\)","\\(28\\text{ cm}\\)","\\(22\\text{ cm}\\)","\\(14\\text{ cm}\\)","\\(7\\text{ cm}\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["\\(\\frac{22}{7} \\times d = 22\\), so \\(d = 7\\text{ cm}\\)."],"hint":"","image":null,"topic":"Circles","type":"objective","section":null},{"question":"Find the sum of the prime factors of \\(30\\).","options":["\\(5\\)","\\(7\\)","\\(8\\)","\\(10\\)","\\(12\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(30 = 2 \\times 3 \\times 5\\); \\(2 + 3 + 5 = 10\\)."],"hint":"","image":null,"topic":"Prime Factors","type":"objective","section":null},{"question":"A rectangular room \\(6\\text{ m}\\) long by \\(5\\text{ m}\\) wide contains \\(120\\text{ m}^{3}\\) of air. Calculate the height of the room.","options":["\\(3\\text{ m}\\)","\\(4\\text{ m}\\)","\\(5\\text{ m}\\)","\\(6\\text{ m}\\)","\\(12\\text{ m}\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["\\(120 \\div (6 \\times 5) = 4\\text{ m}\\)."],"hint":"","image":null,"topic":"Mensuration","type":"objective","section":null},{"question":"Decrease \\(1500\\text{ kg}\\) by \\(15\\%\\).","options":["\\(300\\text{ kg}\\)","\\(1725\\text{ kg}\\)","\\(3825\\text{ kg}\\)","\\(1275\\text{ kg}\\)","\\(22500\\text{ kg}\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(85\\%\\) of \\(1500 = 1275\\text{ kg}\\)."],"hint":"","image":null,"topic":"Percentages","type":"objective","section":null},{"question":"If \\(₦45,000.00\\) is shared among \\(3\\) people in the ratio \\(5 : 4 : 3\\), what is the least share?","options":["\\(₦11,250.00\\)","\\(₦15,000.00\\)","\\(₦18,750.00\\)","\\(₦24,800.00\\)","\\(₦96,000.00\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(\\frac{3}{12} \\times 45\\,000 = ₦11,250\\)."],"hint":"","image":null,"topic":"Ratio","type":"objective","section":null},{"question":"Simplify \\(\\frac{3}{8}\\) of \\(2\\tfrac{2}{9} \\times 1\\tfrac{3}{5}\\).","options":["\\(1\\tfrac{1}{3}\\)","\\(1\\tfrac{2}{3}\\)","\\(2\\tfrac{1}{3}\\)","\\(2\\tfrac{2}{3}\\)","\\(3\\tfrac{1}{3}\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(\\frac{3}{8} \\times \\frac{20}{9} \\times \\frac{8}{5} = \\frac{4}{3} = 1\\tfrac{1}{3}\\)."],"hint":"","image":null,"topic":"Fractions","type":"objective","section":null},{"question":"By how much is \\(75\\%\\) of \\(₦1000\\) greater than \\(25\\%\\) of \\(₦600\\)?","options":["\\(₦160\\)","\\(₦350\\)","\\(₦90\\)","\\(₦750\\)","\\(₦600\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["\\(750 - 150 = ₦600\\)."],"hint":"","image":null,"topic":"Percentages","type":"objective","section":null},{"question":"The temperature during the day in a cold country is \\(8^{\\circ}\\text{C}\\). At night the temperature falls by \\(10^{\\circ}\\text{C}\\). What is the night temperature?","options":["\\(-2^{\\circ}\\text{C}\\)","\\(+4^{\\circ}\\text{C}\\)","\\(+18^{\\circ}\\text{C}\\)","\\(-18^{\\circ}\\text{C}\\)","\\(-80^{\\circ}\\text{C}\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(8 - 10 = -2^{\\circ}\\text{C}\\)."],"hint":"","image":null,"topic":"Directed Numbers","type":"objective","section":null},{"question":"Three-quarters of the eggs in a basket are good. If there are \\(300\\) eggs in the basket, how many eggs are bad?","options":["\\(120\\)","\\(125\\)","\\(150\\)","\\(75\\)","\\(35\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["One quarter is bad: \\(\\frac{1}{4} \\times 300 = 75\\)."],"hint":"","image":null,"topic":"Fractions","type":"objective","section":null},{"question":"Make \\(x\\) the subject of the formula in this equation: \\(2xy = w + x\\).","options":["\\(\\frac{w}{2x + 1}\\)","\\(\\frac{x}{2w + 3}\\)","\\(\\frac{w}{2y - 1}\\)","\\(\\frac{w}{2y - 3}\\)","\\(\\frac{x}{2w - 3}\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(2xy - x = w\\), so \\(x(2y - 1) = w\\) and \\(x = \\frac{w}{2y - 1}\\)."],"hint":"","image":null,"topic":"Change of Subject","type":"objective","section":null},{"question":"Find the value of \\(y\\) if \\(\\frac{10}{y - 3} = -2\\).","options":["\\(-2\\)","\\(-0.5\\)","\\(\\frac{1}{2}\\)","\\(-2.5\\)","\\(5.5\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(y - 3 = -5\\), so \\(y = -2\\)."],"hint":"","image":null,"topic":"Algebra","type":"objective","section":null},{"question":"The Lowest Common Multiple of \\(10a^{2}b\\) and \\(8ab\\) is:","options":["\\(2a^{2}b\\)","\\(2ab\\)","\\(4a\\)","\\(40a^{2}b\\)","\\(18ab\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["LCM of \\(10\\) and \\(8\\) is \\(40\\); highest powers \\(a^{2}\\) and \\(b\\). LCM \\(= 40a^{2}b\\)."],"hint":"","image":null,"topic":"HCF and LCM","type":"objective","section":null},{"question":"The probability of passing an examination is \\(0.11\\). What is the probability of failing the examination?","options":["\\(0.99\\)","\\(0.23\\)","\\(0.89\\)","\\(0.72\\)","\\(0.77\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(1 - 0.11 = 0.89\\)."],"hint":"","image":null,"topic":"Probability","type":"objective","section":null},{"question":"Find the smallest number by which \\(60\\) must be multiplied so that the product is a perfect square.","options":["\\(7\\)","\\(12\\)","\\(14\\)","\\(8\\)","\\(15\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["\\(60 = 2^{2} \\times 3 \\times 5\\); multiply by \\(15\\) to get \\(900 = 30^{2}\\)."],"hint":"","image":null,"topic":"Indices","type":"objective","section":null},{"question":"A girl is standing at a point \\(8\\text{ m}\\) away from a building, making an angle of elevation of \\(45^{\\circ}\\) with the top of the building. Find the height of the building.","options":["\\(4\\text{ m}\\)","\\(5\\text{ m}\\)","\\(8\\text{ m}\\)","\\(37\\text{ m}\\)","\\(53\\text{ m}\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(h = 8 \\tan 45^{\\circ} = 8\\text{ m}\\)."],"hint":"","image":null,"topic":"Trigonometry","type":"objective","section":null},{"question":"Approximate \\(234.657\\) to \\(2\\) significant figures.","options":["\\(230.652\\)","\\(230\\)","\\(220\\)","\\(234.66\\)","\\(240\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["The third figure is \\(4\\), so round down: \\(230\\)."],"hint":"","image":null,"topic":"Approximation","type":"objective","section":null},{"question":"The table shows the scores of a certain number of students in a class. Score: \\(2, 4, 5, 6, 7\\); number of students: \\(5, 3, 6, 4, 2\\). Find the modal score.","options":["\\(2\\)","\\(4\\)","\\(5\\)","\\(6\\)","\\(7\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["The score \\(5\\) has the most students (\\(6\\))."],"hint":"","image":null,"topic":"Statistics","type":"objective","section":null},{"question":"The table shows the scores of a certain number of students in a class. Score: \\(2, 4, 5, 6, 7\\); number of students: \\(5, 3, 6, 4, 2\\). If \\(70\\%\\) of the students failed, what is the pass mark?","options":["\\(2\\)","\\(4\\)","\\(5\\)","\\(6\\)","\\(7\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["There are \\(20\\) students; \\(70\\%\\) is \\(14\\).","\\(5 + 3 + 6 = 14\\) students scored \\(5\\) or less, so the pass mark is \\(6\\)."],"hint":"","image":null,"topic":"Statistics","type":"objective","section":null},{"question":"The five-digit number \\(24X8Y\\) is divisible by \\(4\\), \\(5\\) and \\(9\\). What is the sum of \\(X\\) and \\(Y\\)?","options":["\\(13\\)","\\(10\\)","\\(9\\)","\\(5\\)","\\(4\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["Divisible by \\(5\\) and \\(4\\): \\(Y = 0\\) (\\(80\\) is a multiple of \\(4\\)).","Digit sum \\(2 + 4 + X + 8 + 0 = 14 + X\\) must be a multiple of \\(9\\): \\(X = 4\\).","\\(X + Y = 4\\)."],"hint":"","image":null,"topic":"Divisibility","type":"objective","section":null},{"question":"The inequality graph represents which of the given options?","options":["\\(x > -2\\)","\\(x < -1\\)","\\(x < -2\\)","\\(x > -1\\)","\\(x \\le -1\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["An open circle at \\(-1\\) with the arrow to the right: \\(x > -1\\)."],"hint":"","image":"/exam-archive/competitions/scholastic/junior-secondary/5th-edition/first-Round/q23.svg","topic":"Inequalities","type":"objective","section":null},{"question":"Find the sum of all the interior angles of a polygon having \\(9\\) sides.","options":["\\(180^{\\circ}\\)","\\(360^{\\circ}\\)","\\(720^{\\circ}\\)","\\(1260^{\\circ}\\)","\\(900^{\\circ}\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\((9 - 2) \\times 180^{\\circ} = 1260^{\\circ}\\)."],"hint":"","image":null,"topic":"Polygons","type":"objective","section":null},{"question":"A sector of a circle of radius \\(4\\text{ cm}\\) has an angle of \\(45^{\\circ}\\). What is its area in \\(\\text{cm}^{2}\\) in terms of \\(\\pi\\)?","options":["\\(9\\pi\\)","\\(2\\pi\\)","\\(4\\pi\\)","\\(8\\pi\\)","\\(22\\pi\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["\\(\\frac{45}{360} \\times \\pi \\times 4^{2} = 2\\pi\\)."],"hint":"","image":null,"topic":"Circles","type":"objective","section":null},{"question":"John has \\(6\\) sisters and \\(3\\) brothers. His sister Jane has \\(P\\) sisters and \\(Q\\) brothers. What is the sum of \\(P\\) and \\(Q\\)?","options":["\\(3\\)","\\(5\\)","\\(9\\)","\\(10\\)","\\(11\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["Jane has \\(5\\) sisters, and \\(4\\) brothers (John's \\(3\\) plus John).","\\(5 + 4 = 9\\)."],"hint":"","image":null,"topic":"Logic","type":"objective","section":null},{"question":"Two angles of a triangle are \\(40^{\\circ}\\) and \\(80^{\\circ}\\). The triangle is:","options":["Right angled","Obtuse angled","Equilateral","Isosceles","Scalene"],"correctIndex":4,"answer":null,"accept":null,"explanation":["The third angle is \\(60^{\\circ}\\). All three angles differ, so all sides differ: scalene."],"hint":"","image":null,"topic":"Triangles","type":"objective","section":null},{"question":"Fubara bought a bike for \\(₦200000\\). He wants to sell it making a \\(10\\%\\) profit. What is the selling price of the bike?","options":["\\(₦200020\\)","\\(₦220000\\)","\\(₦210000\\)","\\(₦200010\\)","\\(₦202000\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["\\(110\\%\\) of \\(200\\,000 = ₦220\\,000\\)."],"hint":"","image":null,"topic":"Profit and Loss","type":"objective","section":null,"film":"bike-profit-10"},{"question":"Eight people meet for a particular programme. Each person shakes hands once with every other person present. How many handshakes took place?","options":["\\(28\\)","\\(29\\)","\\(30\\)","\\(60\\)","\\(64\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(\\frac{8 \\times 7}{2} = 28\\)."],"hint":"","image":null,"topic":"Counting","type":"objective","section":null},{"question":"In the expansion of \\((x - 4)(x - 5)\\), what is the coefficient of \\(x\\)?","options":["\\(-9\\)","\\(-2\\)","\\(+1\\)","\\(+7\\)","\\(+4\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(x^{2} - 5x - 4x + 20 = x^{2} - 9x + 20\\)."],"hint":"","image":null,"topic":"Expansion","type":"objective","section":null},{"question":"A trapezium has an area of \\(d\\text{ m}^{2}\\). Its two parallel sides are \\(19\\text{ m}\\) and \\(11\\text{ m}\\) long and the distance between them is \\(9\\text{ m}\\). Find the value of \\(d\\).","options":[],"correctIndex":null,"answer":"\\(135\\)","accept":["135"],"explanation":["\\(\\frac{1}{2}(19 + 11) \\times 9 = 135\\)."],"hint":"","image":null,"topic":"Mensuration","type":"subjective","section":null},{"question":"In an examination, a student scored \\(60\\) marks out of a possible \\(80\\). What percentage is this?","options":[],"correctIndex":null,"answer":"\\(75\\%\\)","accept":["75%"],"explanation":["\\(\\frac{60}{80} \\times 100 = 75\\%\\)."],"hint":"","image":null,"topic":"Percentages","type":"subjective","section":null},{"question":"If \\(x = 2y - 1\\) and \\(2x = 3y + 2\\), find \\(y\\).","options":[],"correctIndex":null,"answer":"\\(y = 4\\)","accept":["y = 4"],"explanation":["\\(2(2y - 1) = 3y + 2\\), so \\(4y - 2 = 3y + 2\\) and \\(y = 4\\)."],"hint":"","image":null,"topic":"Simultaneous Equations","type":"subjective","section":null},{"question":"Factorise \\(8ax^{2}y - 16ay\\).","options":[],"correctIndex":null,"answer":"\\(8ay(x^{2} - 2)\\)","accept":["8ay(x^2 - 2)"],"explanation":["The common factor is \\(8ay\\): \\(8ay(x^{2} - 2)\\)."],"hint":"","image":null,"topic":"Factorisation","type":"subjective","section":null},{"question":"Solve \\(8(2d - 3) = 3(4d - 7)\\).","options":[],"correctIndex":null,"answer":"\\(d = \\frac{3}{4}\\)","accept":["d = 3/4"],"explanation":["\\(16d - 24 = 12d - 21\\), so \\(4d = 3\\) and \\(d = \\frac{3}{4}\\)."],"hint":"","image":null,"topic":"Algebra","type":"subjective","section":null},{"question":"A car travelled \\(80\\text{ km}\\) in \\(48\\) minutes. Find the speed of the car in km/h.","options":[],"correctIndex":null,"answer":"\\(100\\text{ km/h}\\)","accept":["100 km/h"],"explanation":["\\(48\\) minutes \\(= 0.8\\) hours; \\(80 \\div 0.8 = 100\\text{ km/h}\\)."],"hint":"","image":null,"topic":"Speed","type":"subjective","section":null},{"question":"Express \\(0.0104\\) in standard form.","options":[],"correctIndex":null,"answer":"\\(1.04 \\times 10^{-2}\\)","accept":["1.04 × 10^-2"],"explanation":["Move the point two places right: \\(1.04 \\times 10^{-2}\\)."],"hint":"","image":null,"topic":"Standard Form","type":"subjective","section":null},{"question":"Calculate the size of the largest angle in the diagram.","options":[],"correctIndex":null,"answer":"\\(80^{\\circ}\\)","accept":["80°"],"explanation":["The angles on the straight line at \\(O\\) add up to \\(180^{\\circ}\\): \\(20 + 2x + 5x + 3x = 180\\), so \\(x = 16\\).","The largest is \\(5x = 80^{\\circ}\\)."],"hint":"","image":"/exam-archive/competitions/scholastic/junior-secondary/5th-edition/first-Round/q38.svg","topic":"Angles","type":"subjective","section":null},{"question":"Calculate \\(\\frac{1}{2} - \\frac{3}{5} + \\frac{7}{10}\\).","options":[],"correctIndex":null,"answer":"\\(\\frac{3}{5}\\)","accept":["3/5"],"explanation":["\\(\\frac{5}{10} - \\frac{6}{10} + \\frac{7}{10} = \\frac{6}{10} = \\frac{3}{5}\\)."],"hint":"","image":null,"topic":"Fractions","type":"subjective","section":null},{"question":"If \\(S = (5.42)^{2} - (4.58)^{2}\\), find \\(S\\).","options":[],"correctIndex":null,"answer":"\\(8.4\\)","accept":["8.4"],"explanation":["Difference of two squares: \\((5.42 - 4.58)(5.42 + 4.58) = 0.84 \\times 10 = 8.4\\)."],"hint":"","image":null,"topic":"Difference of Two Squares","type":"subjective","section":null}]}