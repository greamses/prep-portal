opic":"Factorisation","type":"subjective","section":null},{"question":"I think of a number. \\(19\\) subtracted from the number gives \\(-2\\). What number am I thinking of?","options":[],"correctIndex":null,"answer":"\\(17\\)","accept":["17"],"explanation":["\\(n - 19 = -2\\), so \\(n = 17\\)."],"hint":"","image":null,"topic":"Algebra","type":"subjective","section":null},{"question":"Find the value of \\(0.8 \\div (0.17 - 0.09)\\).","options":[],"correctIndex":null,"answer":"\\(10\\)","accept":["10"],"explanation":["\\(0.17 - 0.09 = 0.08\\); \\(0.8 \\div 0.08 = 10\\)."],"hint":"","image":null,"topic":"Decimals","type":"subjective","section":null},{"question":"Find the HCF of \\(32\\), \\(40\\) and \\(56\\).","options":[],"correctIndex":null,"answer":"\\(8\\)","accept":["8"],"explanation":["\\(32 = 2^{5}\\), \\(40 = 2^{3} \\times 5\\), \\(56 = 2^{3} \\times 7\\); HCF \\(= 2^{3} = 8\\)."],"hint":"","image":null,"topic":"HCF and LCM","type":"subjective","section":null},{"question":"Solve the equation \\(5 - \\frac{2x}{3} = 1\\).","options":[],"correctIndex":null,"answer":"\\(x = 6\\)","accept":["x = 6"],"explanation":["\\(\\frac{2x}{3} = 4\\), so \\(x = 6\\)."],"hint":"","image":null,"topic":"Algebra","type":"subjective","section":null},{"question":"What is the complement of an angle of \\(70^{\\circ}\\)?","options":[],"correctIndex":null,"answer":"\\(20^{\\circ}\\)","accept":["20°"],"explanation":["Complementary angles add up to \\(90^{\\circ}\\): \\(90 - 70 = 20^{\\circ}\\)."],"hint":"","image":null,"topic":"Angles","type":"subjective","section":null},{"question":"The number which occurs most frequently in a set of numbers is called the ____.","options":[],"correctIndex":null,"answer":"mode","accept":["mode"],"explanation":["The most frequent value is the mode."],"hint":"","image":null,"topic":"Statistics","type":"subjective","section":null},{"question":"In the given figure, \\(AB = AC\\) and \\(\\angle ACD = 105^{\\circ}\\). What is \\(\\angle BAC\\)?","options":[]