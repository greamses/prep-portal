ectIndex":3,"answer":null,"explanation":["\\( \\frac{1}{2}+\\frac{1}{3}+\\frac{1}{6}=1 \\); \\( \\frac{1}{2}-\\frac{1}{3}=\\frac{1}{6} \\); \\( 1\\div\\frac{1}{6}=6 \\)."],"hint":"Top \\( = 1 \\), bottom \\( = \\frac{1}{6} \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"Which of the following is NOT divisible by \\( 6 \\)?","options":["\\( 246 \\)","\\( 336 \\)","\\( 432 \\)","\\( 456 \\)","\\( 578 \\)"],"correctIndex":4,"answer":null,"explanation":["\\( 5+7+8 = 20 \\) is not divisible by \\( 3 \\), so \\( 578 \\) is not divisible by \\( 6 \\)."],"hint":"Divisible by \\( 6 \\) means even and digit-sum divisible by \\( 3 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"Which of the following is equal to \\( \\dfrac{2}{7} \\)?","options":["\\( \\dfrac{16}{60} \\)","\\( \\dfrac{8}{32} \\)","\\( \\dfrac{6}{28} \\)","\\( \\dfrac{12}{40} \\)","\\( \\dfrac{10}{35} \\)"],"correctIndex":4,"answer":null,"explanation":["\\( \\frac{10}{35} = \\frac{2}{7} \\)."],"hint":"Simplify each fraction.","image":null,"topic":null,"type":"objective","section":null},{"question":"Which of the following is NOT a prime number?","options":["\\( 2 \\)","\\( 3 \\)","\\( 5 \\)","\\( 7 \\)","\\( 10 \\)"],"correctIndex":4,"answer":null,"explanation":["\\( 10 = 2\\times 5 \\) is composite."],"hint":"Which one has more than two factors?","image":null,"topic":null,"type":"objective","section":null},{"question":"A father's current age is six times the age difference between his two children. In two years he will be \\( 56 \\). Find the age difference between the children.","options":["\\( 5 \\)","\\( 6 \\)","\\( 8 \\)","\\( 9 \\)","\\( 10 \\)"],"correctIndex":3,"answer":null,"explanation":["\\( 54 = 6\\times d \\Rightarrow d = 9 \\)."],"hint":"Father's current age \\( = 56 - 2 = 54 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"Evaluate \\( 51.4 + 2.41 \\).","options":["\\( 53.81 \\)","\\( 62.6 \\)","\\( 75.5 \\)","\\( 87.214 \\)","\\( 100 \\)"],"correctIndex":0,"answer":null,"explanation":["\\( 51.40 + 2.41 = 53.81 \\)."],"hint":"Line up the decimal points.","image":null,"topic":null,"type":"objective","section":null},{"question":"Find \\( x \\) if \\( 5x + 4 = 19 \\).","options":["\\( 0 \\)","\\( 1 \\)","\\( 2 \\)","\\( 3 \\)","\\( 4 \\)"],"correctIndex":3,"answer":null,"explanation":["\\( 5x = 15 \\Rightarrow x = 3 \\)."],"hint":"Subtract \\( 4 \\), then divide by \\( 5 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the L.C.M. of \\( 12 \\), \\( 16 \\) and \\( 20 \\).","options":["\\( 180 \\)","\\( 210 \\)","\\( 220 \\)","\\( 240 \\)","\\( 300 \\)"],"correctIndex":3,"answer":null,"explanation":["\\( \\text{LCM} = 2^4\\times3\\times5 = 240 \\)."],"hint":"Use prime factors: \\( 2^4\\times3\\times5 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"Change \\( 4500 \\) cm to metres.","options":["\\( 0.45 \\) m","\\( 4.5 \\) m","\\( 45 \\) m","\\( 45000 \\) m","\\( 450000 \\) m"],"correctIndex":2,"answer":null,"explanation":["\\( 4500\\div 100 = 45 \\) m."],"hint":"\\( 100 \\) cm \\( = 1 \\) m.","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the average of \\( 3, 5, 5, 7, 7, 9 \\).","options":["\\( 5 \\)","\\( 6 \\)","\\( 7 \\)","\\( 8 \\)","\\( 9 \\)"],"correctIndex":1,"answer":null,"explanation":["\\( \\frac{3+5+5+7+7+9}{6} = \\frac{36}{6} = 6 \\)."],"hint":"Add them and divide by \\( 6 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"\\( 133 \\) tonnes of sand was carried by three lorries of capacity \\( 5 \\), \\( 6 \\) and \\( 8 \\) tonnes. If each made the same number of trips, how many trips did each make?","options":["\\( 7 \\)","\\( 8 \\)","\\( 10 \\)","\\( 11 \\)","\\( 13 \\)"],"correctIndex":0,"answer":null,"explanation":["\\( 19n = 133 \\Rightarrow n = 7 \\) trips each."],"hint":"Together they carry \\( 5+6+8 = 19 \\) tonnes per round of trips.","image":null,"topic":null,"type":"objective","section":null},{"question":"Which of the following is greater than \\( 77{,}777 \\)?","options":["\\( 77{,}121 \\)","\\( 76{,}543 \\)","\\( 77{,}689 \\)","\\( 70{,}999 \\)","\\( 77{,}781 \\)"],"correctIndex":4,"answer":null,"explanation":["\\( 77{,}781 > 77{,}777 \\); all others are smaller."],"hint":"Compare digit by digit.","image":null,"topic":null,"type":"objective","section":null},{"question":"How many hours are there in \\( 2 \\) weeks \\( 6 \\) days?","options":["\\( 500 \\)","\\( 480 \\)","\\( 460 \\)","\\( 440 \\)","\\( 420 \\)"],"correctIndex":1,"answer":null,"explanation":["\\( 20\\times 24 = 480 \\) hours."],"hint":"\\( 2 \\) weeks \\( 6 \\) days \\( = 20 \\) days; each day has \\( 24 \\) hours.","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the value of \\( 100 - 99 + 98 - 97 + 96 - 95 + \\cdots + 4 - 3 + 2 - 1 \\).","options":["\\( 50 \\)","\\( 40 \\)","\\( 35 \\)","\\( 30 \\)","\\( 20 \\)"],"correctIndex":0,"answer":null,"explanation":["There are \\( 50 \\) pairs, each equal to \\( 1 \\): total \\( = 50 \\)."],"hint":"Group the numbers into pairs.","image":null,"topic":null,"type":"objective","section":null},{"question":"Ten more than twice a number is \\( 20 \\). What is the number?","options":["\\( 5 \\)","\\( 10 \\)","\\( 0 \\)","\\( 20 \\)","\\( 15 \\)"],"correctIndex":0,"answer":null,"explanation":["\\( 2n = 10 \\Rightarrow n = 5 \\)."],"hint":"Solve \\( 2n + 10 = 20 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"The balance is level: a triangle and a square in the left pan, six circles in the right pan. A triangle weighs four times a circle, and a square weighs \\( 3 \\) g more than a circle. If \\( x \\) is the mass of a circle, which equation models the balance?","options":["\\( 3x + (x+6) = 4x \\)","\\( 4x - (x-3) = 6x \\)","\\( 4x + (x+3) = 6x \\)","\\( 6x - (x+4) = 3x \\)","\\( 6x - (x-4) = 3x \\)"],"correctIndex":2,"answer":null,"explanation":["Triangle \\( = 4x \\), square \\( = x+3 \\), six circles \\( = 6x \\): \\( 4x + (x+3) = 6x \\)."],"hint":"Left pan \\( = \\) triangle \\( + \\) square \\( = 4x + (x+3) \\); right pan \\( = 6x \\).","image":"<svg viewBox=\"0 0 220 120\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><line x1=\"20\" y1=\"40\" x2=\"200\" y2=\"40\"/><line x1=\"110\" y1=\"40\" x2=\"110\" y2=\"95\"/><path d=\"M40 40 a45 18 0 0 0 50 0\" /><path d=\"M130 40 a45 18 0 0 0 50 0\"/><path d=\"M55 30 l8 -14 l8 14 z\"/><rect x=\"72\" y=\"20\" width=\"12\" height=\"12\"/><circle cx=\"140\" cy=\"22\" r=\"4\"/><circle cx=\"152\" cy=\"22\" r=\"4\"/><circle cx=\"164\" cy=\"22\" r=\"4\"/><circle cx=\"140\" cy=\"34\" r=\"4\"/><circle cx=\"152\" cy=\"34\" r=\"4\"/><circle cx=\"164\" cy=\"34\" r=\"4\"/></svg>","topic":null,"type":"objective","section":null},{"question":"A parallelogram has","options":["\\( 1 \\) side","\\( 2 \\) sides","\\( 3 \\) sides","\\( 4 \\) sides","\\( 5 \\) sides"],"correctIndex":3,"answer":null,"explanation":["A parallelogram has \\( 4 \\) sides."],"hint":"Count its edges.","image":null,"topic":null,"type":"objective","section":null},{"question":"The volume of the cuboid (\\( 5 \\) cm \\( \\times \\) \\( 6 \\) cm \\( \\times \\) \\( 10 \\) cm) is","options":["\\( 110\\ \\text{cm}^3 \\)","\\( 240\\ \\text{cm}^3 \\)","\\( 300\\ \\text{cm}^3 \\)","\\( 320\\ \\text{cm}^3 \\)","\\( 360\\ \\text{cm}^3 \\)"],"correctIndex":2,"answer":null,"explanation":["\\( 5\\times 6\\times 10 = 300\\ \\text{cm}^3 \\)."],"hint":"Volume \\( = l\\times w\\times h \\).","image":"<svg viewBox=\"0 0 200 130\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><path d=\"M30 50 L130 50 L130 110 L30 110 Z\"/><path d=\"M30 50 L60 25 L160 25 L130 50 M130 110 L160 85 L160 25 M130 50 L160 25\" /><text x=\"80\" y=\"38\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">10 cm</text><text x=\"20\" y=\"82\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">6 cm</text><text x=\"150\" y=\"70\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">5 cm</text></svg>","topic":null,"type":"objective","section":null},{"question":"Find \\( x \\) in the given right-angled triangle (one angle is \\( 60^{\\circ} \\)).","options":["\\( 20^{\\circ} \\)","\\( 30^{\\circ} \\)","\\( 40^{\\circ} \\)","\\( 50^{\\circ} \\)","\\( 60^{\\circ} \\)"],"correctIndex":1,"answer":null,"explanation":["\\( x = 180^{\\circ} - 90^{\\circ} - 60^{\\circ} = 30^{\\circ} \\)."],"hint":"The three angles sum to \\( 180^{\\circ} \\); one is a right angle.","image":"<svg viewBox=\"0 0 130 120\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><path d=\"M25 100 L110 100 L110 30 Z\"/><rect x=\"100\" y=\"90\" width=\"10\" height=\"10\" stroke-width=\"1.5\"/><text x=\"102\" y=\"24\" fill=\"currentColor\" stroke=\"none\" font-size=\"13\" text-anchor=\"middle\">x</text><text x=\"95\" y=\"96\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">60°</text></svg>","topic":null,"type":"objective","section":null},{"question":"The pencil in the figure is made of which two solids?","options":["a cuboid and a cone","a cylinder and a cone","a cylinder and a cube","a sphere and a cylinder","a sphere and a cuboid"],"correctIndex":1,"answer":null,"explanation":["The body is a cylinder and the tip is a cone."],"hint":"The body is round; the sharpened tip is pointed.","image":"<svg viewBox=\"0 0 200 70\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><path d=\"M20 25 H140 V45 H20 Z\"/><path d=\"M140 25 L175 35 L140 45 Z\"/></svg>","topic":null,"type":"objective","section":null},{"question":"A rectangle has perimeter \\( 64 \\) m. Find its length if the breadth is \\( 12 \\) m.","options":["\\( 76 \\) m","\\( 52 \\) m","\\( 20 \\) m","\\( 16 \\) m","\\( 12 \\) m"],"correctIndex":2,"answer":null,"explanation":["\\( l + 12 = 32 \\Rightarrow l = 20 \\) m."],"hint":"\\( 2(l + 12) = 64 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the area of a square whose perimeter is \\( 4 \\) cm.","options":["\\( 1\\ \\text{cm}^2 \\)","\\( 2\\ \\text{cm}^2 \\)","\\( 4\\ \\text{cm}^2 \\)","\\( 8\\ \\text{cm}^2 \\)","\\( 16\\ \\text{cm}^2 \\)"],"correctIndex":0,"answer":null,"explanation":["Side \\( 1 \\) cm gives area \\( 1\\times 1 = 1\\ \\text{cm}^2 \\)."],"hint":"Side \\( = 4\\div 4 = 1 \\) cm.","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the perimeter of a quarter circle of radius \\( 7 \\) cm. \\( \\left(\\pi = \\dfrac{22}{7}\\right) \\)","options":["\\( 48 \\) cm","\\( 36 \\) cm","\\( 32 \\) cm","\\( 25 \\) cm","\\( 20 \\) cm"],"correctIndex":3,"answer":null,"explanation":["Arc \\( = \\frac{1}{4}(2\\pi r) = \\frac{1}{4}\\times 44 = 11 \\); plus \\( 7+7 \\): \\( 11 + 14 = 25 \\) cm."],"hint":"Perimeter \\( = \\) quarter of the circumference \\( + \\) two radii.","image":"<svg viewBox=\"0 0 120 120\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><path d=\"M20 100 L20 20 A80 80 0 0 1 100 100 Z\"/></svg>","topic":null,"type":"objective","section":null},{"question":"Find the total area of the two shapes if each unit square represents \\( 4\\ \\text{cm}^2 \\).","options":["\\( 34\\ \\text{cm}^2 \\)","\\( 30\\ \\text{cm}^2 \\)","\\( 28\\ \\text{cm}^2 \\)","\\( 24\\ \\text{cm}^2 \\)","\\( 20\\ \\text{cm}^2 \\)"],"correctIndex":2,"answer":null,"explanation":["The two shapes cover about \\( 7 \\) unit squares: \\( 7\\times 4 = 28\\ \\text{cm}^2 \\). ⚠ Square count read from the scan — verify against the official figure."],"hint":"Count the unit squares the shapes cover, then multiply by \\( 4 \\).","image":"<svg viewBox=\"0 0 170 110\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"10\" y=\"10\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"35\" y=\"10\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"60\" y=\"10\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"85\" y=\"10\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"110\" y=\"10\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"135\" y=\"10\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"10\" y=\"32\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"35\" y=\"32\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"60\" y=\"32\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"85\" y=\"32\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"110\" y=\"32\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"135\" y=\"32\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"10\" y=\"54\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"35\" y=\"54\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"60\" y=\"54\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"85\" y=\"54\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"110\" y=\"54\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"135\" y=\"54\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"10\" y=\"76\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"35\" y=\"76\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"60\" y=\"76\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"85\" y=\"76\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"110\" y=\"76\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><rect x=\"135\" y=\"76\" width=\"25\" height=\"22\" stroke-width=\"1\" stroke=\"currentColor\" stroke-opacity=\"0.5\"/><path d=\"M10 98 L35 10 L60 98 Z\" fill=\"currentColor\" fill-opacity=\"0.4\"/><path d=\"M110 10 L160 10 L110 98 Z\" fill=\"currentColor\" fill-opacity=\"0.4\"/></svg>","topic":null,"type":"objective","section":null},{"question":"Two parallel lines are cut by two transversals; one angle is \\( 40^{\\circ} \\) (angles labelled \\( a,b,c,d,e,f,h \\)). Which one is NOT equal to \\( 40^{\\circ} \\)?","options":["\\( e \\)","\\( b \\)","\\( a \\)","\\( d \\)","They are all equal to \\( 40^{\\circ} \\)"],"correctIndex":1,"answer":null,"explanation":["\\( b \\) is