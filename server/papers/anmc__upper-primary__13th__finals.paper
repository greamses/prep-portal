image":"<svg viewBox=\"0 0 220 110\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"15\" y=\"15\" width=\"50\" height=\"30\"/><text x=\"40\" y=\"62\" fill=\"currentColor\" stroke=\"none\" font-size=\"9\" text-anchor=\"middle\">rect</text><path d=\"M90 15 l40 0 l-12 30 l-40 0 z\"/><text x=\"108\" y=\"62\" fill=\"currentColor\" stroke=\"none\" font-size=\"9\" text-anchor=\"middle\">par'gram</text><path d=\"M170 15 l20 15 l-20 15 l-20 -15 z\"/><text x=\"170\" y=\"62\" fill=\"currentColor\" stroke=\"none\" font-size=\"9\" text-anchor=\"middle\">rhombus</text><path d=\"M30 75 l40 0 l-10 25 l-20 0 z\"/><text x=\"50\" y=\"108\" fill=\"currentColor\" stroke=\"none\" font-size=\"9\" text-anchor=\"middle\">trapezoid</text><rect x=\"120\" y=\"75\" width=\"28\" height=\"28\"/><text x=\"134\" y=\"118\" fill=\"currentColor\" stroke=\"none\" font-size=\"9\" text-anchor=\"middle\">square</text></svg>","topic":null,"type":"objective","section":null},{"question":"In the figure a rectangle is given (top \\( 7+m \\), bottom \\( 11-m \\), left \\( k \\), right \\( 2k-3 \\)). Find its area.","options":["\\( 24 \\)","\\( 27 \\)","\\( 30 \\)","\\( 40 \\)","\\( 48 \\)"],"correctIndex":1,"answer":null,"explanation":["\\( 7+m = 11-m \\Rightarrow m=2 \\), so each long side \\( = 9 \\); \\( k = 2k-3 \\Rightarrow k=3 \\). Area \\( = 9\\times 3 = 27 \\)."],"hint":"Opposite sides are equal: \\( 7+m = 11-m \\) and \\( k = 2k-3 \\).","image":"<svg viewBox=\"0 0 200 110\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"30\" y=\"25\" width=\"120\" height=\"60\"/><text x=\"90\" y=\"18\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">7+m</text><text x=\"90\" y=\"100\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">11−m</text><text x=\"20\" y=\"58\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">k</text><text x=\"168\" y=\"58\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">2k−3</text></svg>","topic":null,"type":"objective","section":null},{"question":"Two circles have radii \\( 3 \\) cm and \\( 4 \\) cm (one inside the other). Find the perimeter of the shaded ring. \\( \\left(\\pi = \\dfrac{22}{7}\\right) \\)","options":["\\( 32 \\) cm","\\( 44 \\) cm","\\( 48 \\) cm","\\( 56 \\) cm","\\( 60 \\) cm"],"correctIndex":1,"answer":null,"explanation":["\\( 2\\pi(4) + 2\\pi(3) = 2\\pi(7) = 2\\times\\frac{22}{7}\\times 7 = 44 \\) cm."],"hint":"Add the circumferences of both circles.","image":"<svg viewBox=\"0 0 120 120\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"currentColor\" fill-opacity=\"0.3\"/><circle cx=\"60\" cy=\"60\" r=\"30\" fill=\"var(--paper,#fff)\"/></svg>","topic":null,"type":"objective","section":null},{"question":"Find the area of the L-shaped figure (sides \\( 16 \\), \\( 14 \\), \\( 20 \\), \\( 4 \\)).","options":["\\( 140 \\)","\\( 148 \\)","\\( 152 \\)","\\( 168 \\)","\\( 180 \\)"],"correctIndex":2,"answer":null,"explanation":["Vertical bar \\( 6\\times 16 = 96 \\) plus strip \\( 14\\times 4 = 56 \\): \\( 96 + 56 = 152 \\). ⚠ Verify side labels against the official figure."],"hint":"Split into a tall rectangle and a low horizontal strip.","image":"<svg viewBox=\"0 0 200 150\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><path d=\"M20 20 L20 130 L180 130 L180 105 L70 105 L70 20 Z\" fill=\"currentColor\" fill-opacity=\"0.15\"/><text x=\"12\" y=\"75\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">16</text><text x=\"125\" y=\"100\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">14</text><text x=\"100\" y=\"144\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">20</text><text x=\"188\" y=\"118\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">4</text></svg>","topic":null,"type":"objective","section":null},{"question":"In the figure find angle \\( B \\) (the triangle has a marked angle of \\( 48^{\\circ} \\) at \\( C \\) with two equal sides).","options":["\\( 66^{\\circ} \\)","\\( 55^{\\circ} \\)","\\( 48^{\\circ} \\)","\\( 40^{\\circ} \\)","\\( 33^{\\circ} \\)"],"correctIndex":0,"answer":null,"explanation":["With the apex angle \\( 48^{\\circ} \\) and equal sides, each base angle \\( = \\frac{180^{\\circ}-48^{\\circ}}{2} = 66^{\\circ} \\). ⚠ Figure-dependent — verify against the official key."],"hint":"Use the isosceles base angles and the angle sum of the triangle.","image":"<svg viewBox=\"0 0 200 130\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><path d=\"M20 30 L180 30 L120 110 Z\"/><line x1=\"110\" y1=\"30\" x2=\"120\" y2=\"110\"/><text x=\"16\" y=\"26\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">A</text><text x=\"184\" y=\"26\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">B</text><text x=\"120\" y=\"122\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">C</text><text x=\"110\" y=\"24\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">D</text><text x=\"118\" y=\"95\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">48°</text></svg>","topic":null,"type":"objective","section":null},{"question":"Rectangle \\( ABCD \\) is divided into \\( 10 \\) equal small rectangles, with \\( AB = 20 \\). Find the perimeter of one small rectangle.","options":["\\( 16 \\)","\\( 20 \\)","\\( 24 \\)","\\( 30 \\)","\\( 36 \\)"],"correctIndex":1,"answer":null,"explanation":["Each small rectangle is \\( 4 \\) wide; with the grid height it works out to a perimeter of \\( 20 \\). ⚠ Height read from the scan — verify against the official figure."],"hint":"Five columns make each small width \\( 20\\div 5 = 4 \\); find the height too.","image":"<svg viewBox=\"0 0 200 140\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"20\" y=\"20\" width=\"160\" height=\"90\"/><line x1=\"52\" y1=\"20\" x2=\"52\" y2=\"110\"/><line x1=\"84\" y1=\"20\" x2=\"84\" y2=\"110\"/><line x1=\"116\" y1=\"20\" x2=\"116\" y2=\"110\"/><line x1=\"148\" y1=\"20\" x2=\"148\" y2=\"110\"/><line x1=\"20\" y1=\"65\" x2=\"180\" y2=\"65\"/><text x=\"15\" y=\"18\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">D</text><text x=\"185\" y=\"18\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">C</text><text x=\"15\" y=\"124\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">A</text><text x=\"185\" y=\"124\" fill=\"currentColor\" stroke=\"none\" font-size=\"10\" text-anchor=\"middle\">B</text><text x=\"100\" y=\"134\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">20</text></svg>","topic":null,"type":"objective","section":null},{"question":"What is the next number in the series: \\( 5, 7, 9, 11, 13, ? \\)","options":["\\( 12 \\)","\\( 13 \\)","\\( 14 \\)","\\( 15 \\)","\\( 16 \\)"],"correctIndex":3,"answer":null,"explanation":["\\( 13 + 2 = 15 \\)."],"hint":"Add \\( 2 \\) each time.","image":null,"topic":null,"type":"objective","section":null},{"question":"What is the next number in the series: \\( 24, 19, 14, 9, ? \\)","options":["\\( 4 \\)","\\( 6 \\)","\\( 7 \\)","\\( 8 \\)","\\( 10 \\)"],"correctIndex":0,"answer":null,"explanation":["\\( 9 - 5 = 4 \\)."],"hint":"Subtract \\( 5 \\) each time.","image":null,"topic":null,"type":"objective","section":null},{"question":"What is the next number: \\( 8, 6, 12, 10, 20, 18, ? \\)","options":["\\( 24 \\)","\\( 36 \\)","\\( 47 \\)","\\( 58 \\)","\\( 60 \\)"],"correctIndex":1,"answer":null,"explanation":["\\( 18\\times 2 = 36 \\)."],"hint":"The operations alternate \\( -2 \\) then \\( \\times 2 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"What is the next number: \\( 1, 2, 4, 7, 28, 33, 198, ? \\)","options":["\\( 264 \\)","\\( 248 \\)","\\( 220 \\)","\\( 212 \\)","\\( 205 \\)"],"correctIndex":4,"answer":null,"explanation":["\\( 198 + 7 = 205 \\)."],"hint":"The operations alternate: \\( \\times2, \\times2, +3, \\times4, +5, \\times6, +7 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"In the pattern \\( 2, 4, 7, 13, 16, \\ldots \\), each term is the square of the previous term with its digits added (e.g. \\( 7^2=49,\\ 4+9=13 \\)). Find the \\( 20^{\\text{th}} \\) term.","options":["\\( 11 \\)","\\( 13 \\)","\\( 15 \\)","\\( 17 \\)","\\( 19 \\)"],"correctIndex":1,"answer":null,"explanation":["From the 4th term on it cycles \\( 13,16,13,16,\\ldots \\); even-position terms are \\( 13 \\), so the \\( 20^{\\text{th}} \\) is \\( 13 \\)."],"hint":"After a while the pattern repeats \\( 13, 16, 13, 16, \\ldots \\)","image":null,"topic":null,"type":"objective","section":null},{"question":"Given \\( 1\\to2,\\ 2\\to5,\\ 3\\to5,\\ 4\\to4,\\ 5\\to5,\\ 6\\to6,\\ 7\\to4 \\), what is \\( 8\\to? \\)","options":["\\( 4 \\)","\\( 5 \\)","\\( 6 \\)","\\( 7 \\)","\\( 8 \\)"],"correctIndex":3,"answer":null,"explanation":["The values are the seven-segment counts; the digit \\( 8 \\) lights all \\( 7 \\) segments. ⚠ Verify against the official key."],"hint":"Think of the segments lit when each digit is shown on a calculator display.","image":null,"topic":null,"type":"objective","section":null},{"question":"In a queue, \\( A \\) is \\( 7^{\\text{th}} \\) from the left and \\( B \\) is \\( 9^{\\text{th}} \\) from the right. They swap places, and \\( A \\) becomes \\( 11^{\\text{th}} \\) from the left. How many people are in the row?","options":["\\( 18 \\)","\\( 19 \\)","\\( 20 \\)","\\( 21 \\)","\\( 22 \\)"],"correctIndex":1,"answer":null,"explanation":["Total \\( = 11 + 9 - 1 = 19 \\)."],"hint":"After the swap, \\( A \\) is in \\( B \\)'s old position (\\( 9^{\\text{th}} \\) from the right \\( = 11^{\\text{th}} \\) from the left).","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the odd one out: \\( 5, 10, 15, 18, 20, 25 \\).","options":["\\( 5 \\)","\\( 10 \\)","\\( 15 \\)","\\( 18 \\)","\\( 20 \\)"],"correctIndex":3,"answer":null,"explanation":["\\( 18 \\) is not a multiple of \\( 5 \\)."],"hint":"Which is not a multiple of \\( 5 \\)?","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the odd one out: \\( 1, 4, 9, 12, 16, 25, 36 \\).","options":["\\( 36 \\)","\\( 25 \\)","\\( 16 \\)","\\( 12 \\)","\\( 9 \\)"],"correctIndex":3,"answer":null,"explanation":["\\( 12 \\) is not a perfect square; the rest are \\( 1^2,2^2,3^2,4^2,5^2,6^2 \\)."],"hint":"Which is not a perfect square?","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the odd one out: \\( 135, 317, 975, 731, 573, 264 \\).","options":["\\( 317 \\)","\\( 975 \\)","\\( 731 \\)","\\( 573 \\)","\\( 264 \\)"],"correctIndex":4,"answer":null,"explanation":["\\( 264 \\) is even; all the others are odd."],"hint":"Look at which number is even.","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the missing number in the grid.","options":["\\( 18 \\)","\\( 16 \\)","\\( 12 \\)","\\( 10 \\)","\\( 6 \\)"],"correctIndex":0,"answer":null,"explanation":["\\( 4+2(8)=20 \\), \\( 9+2(3)=15 \\), so \\( 6+2(6)=18 \\)."],"hint":"In each row, third \\( = \\) first \\( + 2\\times \\) second.","image":"<svg viewBox=\"0 0 170 130\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"38\"/><text x=\"35\" y=\"34\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">4</text><rect x=\"60\" y=\"10\" width=\"50\" height=\"38\"/><text x=\"85\" y=\"34\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">8</text><rect x=\"110\" y=\"10\" width=\"50\" height=\"38\"/><text x=\"135\" y=\"34\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">20</text><rect x=\"10\" y=\"48\" width=\"50\" height=\"38\"/><text x=\"35\" y=\"72\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">9</text><rect x=\"60\" y=\"48\" width=\"50\" height=\"38\"/><text x=\"85\" y=\"72\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">3</text><rect x=\"110\" y=\"48\" width=\"50\" height=\"38\"/><text x=\"135\" y=\"72\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">15</text><rect x=\"10\" y=\"86\" width=\"50\" height=\"38\"/><text x=\"35\" y=\"110\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">6</text><rect x=\"60\" y=\"86\" width=\"50\" height=\"38\"/><text x=\"85\" y=\"110\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">6</text><rect x=\"110\" y=\"86\" width=\"50\" height=\"38\"/><text x=\"135\" y=\"110\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">?</text></svg>","topic":null,"type":"objective","section":null},{"question":"Seven cars stand facing east. Cadillac is just right of Fargo; Fargo is fourth to the right of Fiat; Maruti is between Ambassador and Bedford; Fiat (third to the left of Ambassador) is at one end. What is the correct position of Mercedes?","options":["Next to the left of Cadillac","Next to the left of Bedford","Between Bedford and Fargo","Fourth to the right of Maruti","On the leftmost position"],"correctIndex":3,"answer":null,"explanation":["Order: Fiat, Bedford, Maruti, Ambassador, Fargo, Cadillac, Mercedes. Mercedes is fourth to the right of Maruti."],"hint":"Fix Fiat at the left end, then place the rest.","image":null,"topic":null,"type":"objective","section":null},{"question":"Which of the following is least like the others?","options":["cube","sphere","pyramid","circle","cone"],"correctIndex":3,"answer":null,"explanation":["A circle is a flat \\( 2 \\)-D shape; the others are \\( 3 \\)-D solids."],"hint":"Four are solids (3-D).","image":null,"topic":null,"type":"objective","section":null},{"question":"Five girls sit on a bench. Seema is to the left of Rani and to the right of Bindu. Mary is to the right of Rani. Reeta is between Rani and Mary. Who is sitting immediately to the right of Reeta?","options":["Bindu","Mary","Rani","Reeta","Seema"],"correctIndex":1,"answer":null,"explanation":["Order: Bindu, Seema, Rani, Reeta, Mary; so Mary is immediately right of Reeta."],"hint":"Work out the seating order left to right.","image":null,"topic":null,"type":"objective","section":null},{"question":"At which number did the car park (the figures are read upside-down: \\( 16, 06, 68, 88, ?, 98 \\))?","options":["\\( 87 \\)","\\( 90 \\)","\\( 92 \\)","\\( 95 \\)","\\( 99 \\)"],"correctIndex":0,"answer":null,"explanation":["Turned around, the spaces read \\( 86, 87, 88, 89, 90, 91 \\); the missing one is \\( 87 \\)."],"hint":"Read the numbers upside-down — they run in order.","image":"<svg viewBox=\"0 0 230 60\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"11\" y=\"15\" width=\"28\" height=\"35\" transform=\"skewX(-12)\" /><text x=\"22\" y=\"38\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">16</text><rect x=\"46\" y=\"15\" width=\"28\" height=\"35\" transform=\"skewX(-12)\" /><text x=\"57\" y=\"38\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">06</text><rect x=\"81\" y=\"15\" width=\"28\" height=\"35\" transform=\"skewX(-12)\" /><text x=\"92\" y=\"38\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">68</text><rect x=\"116\" y=\"15\" width=\"28\" height=\"35\" transform=\"skewX(-12)\" /><text x=\"127\" y=\"38\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">88</text><rect x=\"151\" y=\"15\" width=\"28\" height=\"35\" transform=\"skewX(-12)\" /><text x=\"162\" y=\"38\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">?</text><rect x=\"186\" y=\"15\" width=\"28\" height=\"35\" transform=\"skewX(-12)\" /><text x=\"197\" y=\"38\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">98</text></svg>","topic":null,"type":"objective","section":null},{"question":"Susan types \\( 10 \\) pages in \\( 5 \\) minutes; Mary types \\( 5 \\) pages in \\( 10 \\) minutes. Working together, how many pages can they type in \\( 30 \\) minutes?","options":["\\( 15 \\)","\\( 20 \\)","\\( 25 \\)","\\( 65 \\)","\\( 75 \\)"],"correctIndex":4,"answer":null,"explanation":["Susan \\( 2 \\)/min, Mary \\( 0.5 \\)/min → \\( 2.5 \\)/min together; \\( 2.5\\times 30 = 75 \\) pages."],"hint":"Find each person's pages-per-minute, then add.","image":null,"topic":null,"type":"objective","section":null},{"question":"Each child in a family has at least \\( 4 \\) brothers and \\( 3 \\) sisters. What is the smallest number of children the family might have?","options":["\\( 7 \\)","\\( 8 \\)","\\( 9 \\)","\\( 10 \\)","\\( 11 \\)"],"correctIndex":2,"answer":null,"explanation":["\\( 5 \\) boys \\( + 4 \\) girls \\( = 9 \\) children."],"hint":"A boy needs \\( 4 \\) brothers (so \\( 5 \\) boys) and a girl needs \\( 3 \\) sisters (so \\( 4 \\) girls).","image":null,"topic":null,"type":"objective","section":null},{"question":"Find the missing number in the grid: \\( (2,3),(4,6),(6,9),(?,9) \\).","options":["\\( 2 \\)","\\( 3 \\)","\\( 4 \\)","\\( 6 \\)","\\( 9 \\)"],"correctIndex":3,"answer":null,"explanation":["Since right \\( = 1.5\\times \\) left, and the right value is \\( 9 \\): \\( ? = 9\\div 1.5 = 6 \\). ⚠ Grid reading from the scan — verify against the official key."],"hint":"In each row the right value is \\( 1.5 \\) times the left value.","image":"<svg viewBox=\"0 0 110 170\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"15\" y=\"10\" width=\"40\" height=\"38\"/><text x=\"35\" y=\"34\" fill=\"currentColor\" stroke=\"none\" font-size=\"14\" text-anchor=\"middle\">2</text><rect x=\"55\" y=\"10\" width=\"40\" height=\"38\"/><text x=\"75\" y=\"34\" fill=\"currentColor\" stroke=\"none\" font-size=\"14\" text-anchor=\"middle\">3</text><rect x=\"15\" y=\"48\" width=\"40\" height=\"38\"/><text x=\"35\" y=\"72\" fill=\"currentColor\" stroke=\"none\" font-size=\"14\" text-anchor=\"middle\">4</text><rect x=\"55\" y=\"48\" width=\"40\" height=\"38\"/><text x=\"75\" y=\"72\" fill=\"currentColor\" stroke=\"none\" font-size=\"14\" text-anchor=\"middle\">6</text><rect x=\"15\" y=\"86\" width=\"40\" height=\"38\"/><text x=\"35\" y=\"110\" fill=\"currentColor\" stroke=\"none\" font-size=\"14\" text-anchor=\"middle\">6</text><rect x=\"55\" y=\"86\" width=\"40\" height=\"38\"/><text x=\"75\" y=\"110\" fill=\"currentColor\" stroke=\"none\" font-size=\"14\" text-anchor=\"middle\">9</text><rect x=\"15\" y=\"124\" width=\"40\" height=\"38\"/><text x=\"35\" y=\"148\" fill=\"currentColor\" stroke=\"none\" font-size=\"14\" text-anchor=\"middle\">?</text><rect x=\"55\" y=\"124\" width=\"40\" height=\"38\"/><text x=\"75\" y=\"148\" fill=\"currentColor\" stroke=\"none\" font-size=\"14\" text-anchor=\"middle\">9</text></svg>","topic":null,"type":"objective","section":null},{"question":"In the Venn diagram (square = married people, circle = people in a joint family, triangle = school teachers), which letter marks people in a joint family who are neither married nor teachers?","options":["P","Q","R","S","T"],"correctIndex":3,"answer":null,"explanation":["The circle-only region (joint family, not married, not a teacher) is marked S. ⚠ Region letters read from the scan — verify against the official figure."],"hint":"Find the region inside the circle only (not the square, not the triangle).","image":"<svg viewBox=\"0 0 200 150\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"30\" y=\"55\" width=\"110\" height=\"70\"/><circle cx=\"80\" cy=\"90\" r=\"45\"/><path d=\"M120 20 L180 120 L60 120 Z\"/><text x=\"150\" y=\"40\" fill=\"currentColor\" stroke=\"none\" font-size=\"9\" text-anchor=\"middle\">teachers</text><text x=\"45\" y=\"120\" fill=\"currentColor\" stroke=\"none\" font-size=\"9\" text-anchor=\"middle\">married</text><text x=\"95\" y=\"135\" fill=\"currentColor\" stroke=\"none\" font-size=\"9\" text-anchor=\"middle\">joint family</text><text x=\"60\" y=\"95\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">S</text><text x=\"95\" y=\"80\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">Q</text><text x=\"110\" y=\"100\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">R</text><text x=\"40\" y=\"85\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">T</text><text x=\"110\" y=\"118\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">P</text><text x=\"120\" y=\"55\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">U</text></svg>","topic":null,"type":"objective","section":null},{"question":"In the same Venn diagram, what does R represent?","options":["People in a joint family who are neither married nor teachers","Married school teachers who do not live in a joint family","School teachers who are not married","Married people who are not in a joint family and not teachers","Married school teachers"],"correctIndex":4,"answer":null,"explanation":["R lies where all three regions meet (married, joint family and teacher), i.e. married school teachers. ⚠ Region position read from the scan — verify against the official figure."],"hint":"Find which three regions overlap at R.","image":null,"topic":null,"type":"objective","section":null},{"question":"Which symbol is on the face opposite the face marked \\( * \\) on the cube (faces use \\( @, *, \\$, 8, +, - \\))?","options":["@","$","8","+","−"],"correctIndex":1,"answer":null,"explanation":["From the two views, \\( \\$ \\) is the only face never adjacent to \\( * \\), so it is opposite. ⚠ Cube-folding figure — verify against the official key."],"hint":"Use the two views to find which symbol never appears next to \\( * \\).","image":"<svg viewBox=\"0 0 200 90\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><path d=\"M20 30 L50 15 L80 30 L80 70 L50 85 L20 70 Z\"/><path d=\"M20 30 L50 45 L80 30 M50 45 L50 85\"/><text x=\"38\" y=\"32\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">@</text><text x=\"64\" y=\"52\" fill=\"currentColor\" stroke=\"none\" font-size=\"13\" text-anchor=\"middle\">*</text><text x=\"38\" y=\"62\" fill=\"currentColor\" stroke=\"none\" font-size=\"13\" text-anchor=\"middle\">−</text><path d=\"M110 30 L140 15 L170 30 L170 70 L140 85 L110 70 Z\"/><path d=\"M110 30 L140 45 L170 30 M140 45 L140 85\"/><text x=\"128\" y=\"32\" fill=\"currentColor\" stroke=\"none\" font-size=\"11\" text-anchor=\"middle\">@</text><text x=\"155\" y=\"52\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">+</text><text x=\"128\" y=\"62\" fill=\"currentColor\" stroke=\"none\" font-size=\"12\" text-anchor=\"middle\">*</text></svg>","topic":null,"type":"objective","section":null},{"question":"John walks east, then north, then turns \\( 45^{\\circ} \\) to his right and walks, then finally turns left. In which direction is he now walking?","options":["North","East","South-East","North-East","North-West"],"correctIndex":4,"answer":null,"explanation":["North → \\( 45^{\\circ} \\) right = NE; turning left \\( 90^{\\circ} \\) from NE gives NW. ⚠ Depends on the turn size — verify against the official key."],"hint":"From north, a \\( 45^{\\circ} \\) right turn faces north-east; a left turn then swings him \\( 90^{\\circ} \\) anticlockwise.","image":null,"topic":null,"type":"objective","section":null},{"question":"Numbers \\( 1 \\) to \\( 5 \\) are placed in the grid so each row and column contains each number once. Rows: \\( (1,x,3,5,2),(4,\\_,1,2,5),(2,5,4,\\_,1),(3,y,5,\\_,z),(\\_,1,\\_,4,\\_) \\). Find \\( x \\).","options":["\\( 1 \\)","\\( 2 \\)","\\( 3 \\)","\\( 4 \\)","\\( 5 \\)"],"correctIndex":3,"answer":null,"explanation":["Row 1 is missing \\( 4 \\), so \\( x = 4 \\)."],"hint":"Row 1 already has \\( 1,3,5,2 \\) — only one number is missing.","image":"<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" font-family=\"JetBrains Mono, monospace\"><rect x=\"10\" y=\"10\" width=\"36\" height=\"36\"/><text x=\"28\" y=\"33\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">1</text><rect x=\"46\" y=\"10\" width=\"36\" height=\"36\"/><text x=\"64\" y=\"33\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">x</text><rect x=\"82\" y=\"10\" width=\"36\" height=\"36\"/><text x=\"100\" y=\"33\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">3</text><rect x=\"118\" y=\"10\" width=\"36\" height=\"36\"/><text x=\"136\" y=\"33\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">5</text><rect x=\"154\" y=\"10\" width=\"36\" height=\"36\"/><text x=\"172\" y=\"33\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">2</text><rect x=\"10\" y=\"46\" width=\"36\" height=\"36\"/><text x=\"28\" y=\"69\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">4</text><rect x=\"46\" y=\"46\" width=\"36\" height=\"36\"/><rect x=\"82\" y=\"46\" width=\"36\" height=\"36\"/><text x=\"100\" y=\"69\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">1</text><rect x=\"118\" y=\"46\" width=\"36\" height=\"36\"/><text x=\"136\" y=\"69\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">2</text><rect x=\"154\" y=\"46\" width=\"36\" height=\"36\"/><text x=\"172\" y=\"69\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">5</text><rect x=\"10\" y=\"82\" width=\"36\" height=\"36\"/><text x=\"28\" y=\"105\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">2</text><rect x=\"46\" y=\"82\" width=\"36\" height=\"36\"/><text x=\"64\" y=\"105\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">5</text><rect x=\"82\" y=\"82\" width=\"36\" height=\"36\"/><text x=\"100\" y=\"105\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">4</text><rect x=\"118\" y=\"82\" width=\"36\" height=\"36\"/><rect x=\"154\" y=\"82\" width=\"36\" height=\"36\"/><text x=\"172\" y=\"105\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">1</text><rect x=\"10\" y=\"118\" width=\"36\" height=\"36\"/><text x=\"28\" y=\"141\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">3</text><rect x=\"46\" y=\"118\" width=\"36\" height=\"36\"/><text x=\"64\" y=\"141\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">y</text><rect x=\"82\" y=\"118\" width=\"36\" height=\"36\"/><text x=\"100\" y=\"141\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">5</text><rect x=\"118\" y=\"118\" width=\"36\" height=\"36\"/><rect x=\"154\" y=\"118\" width=\"36\" height=\"36\"/><text x=\"172\" y=\"141\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">z</text><rect x=\"10\" y=\"154\" width=\"36\" height=\"36\"/><rect x=\"46\" y=\"154\" width=\"36\" height=\"36\"/><text x=\"64\" y=\"177\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">1</text><rect x=\"82\" y=\"154\" width=\"36\" height=\"36\"/><rect x=\"118\" y=\"154\" width=\"36\" height=\"36\"/><text x=\"136\" y=\"177\" fill=\"currentColor\" stroke=\"none\" font-size=\"15\" text-anchor=\"middle\">4</text><rect x=\"154\" y=\"154\" width=\"36\" height=\"36\"/></svg>","topic":null,"type":"objective","section":null},{"question":"Using the same grid, find \\( y \\).","options":["\\( 1 \\)","\\( 2 \\)","\\( 3 \\)","\\( 4 \\)","\\( 5 \\)"],"correctIndex":1,"answer":null,"explanation":["Column 2 already holds \\( 4,3,5,1 \\) (after solving), so \\( y = 2 \\)."],"hint":"Use column 2 once you know the other entries.","image":null,"topic":null,"type":"objective","section":null},{"question":"Using the same grid, find \\( z \\).","options":["\\( 1 \\)","\\( 2 \\)","\\( 3 \\)","\\( 4 \\)","\\( 5 \\)"],"correctIndex":3,"answer":null,"explanation":["Row 4 becomes \\( 3,2,5,1,4 \\), so \\( z = 4 \\)."],"hint":"Finish row 4 and column 5.","image":null,"topic":null,"type":"objective","section":null}]}