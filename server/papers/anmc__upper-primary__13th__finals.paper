{"timeLimit":5400,"questions":[{"question":"Evaluate \\( 5 + 10 + 15 + 20 \\)","options":["\\( 45 \\)","\\( 50 \\)","\\( 55 \\)","\\( 60 \\)","\\( 65 \\)"],"correctIndex":1,"answer":null,"explanation":["\\( 5+10+15+20 = 50 \\)."],"hint":"Add the multiples of \\( 5 \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"Evaluate \\( 3 \\times 6 - 10 \\div 2 \\)","options":["\\( 4 \\)","\\( 8 \\)","\\( 9 \\)","\\( 12 \\)","\\( 13 \\)"],"correctIndex":4,"answer":null,"explanation":["\\( 18 - 5 = 13 \\)."],"hint":"Multiply and divide before subtracting.","image":null,"topic":null,"type":"objective","section":null},{"question":"What percentage of an hour is \\( 36 \\) minutes?","options":["\\( 30\\% \\)","\\( 40\\% \\)","\\( 50\\% \\)","\\( 60\\% \\)","\\( 70\\% \\)"],"correctIndex":3,"answer":null,"explanation":["\\( \\frac{36}{60}\\times 100 = 60\\% \\)."],"hint":"An hour is \\( 60 \\) minutes.","image":null,"topic":null,"type":"objective","section":null},{"question":"Simplify \\( \\left(1+\\dfrac{1}{2}\\right)\\left(1+\\dfrac{1}{3}\\right)\\left(1+\\dfrac{1}{4}\\right)\\left(1+\\dfrac{1}{5}\\right) \\).","options":["\\( 1 \\)","\\( 2 \\)","\\( 3 \\)","\\( 4 \\)","\\( 5 \\)"],"correctIndex":2,"answer":null,"explanation":["\\( \\frac{3}{2}\\cdot\\frac{4}{3}\\cdot\\frac{5}{4}\\cdot\\frac{6}{5} = \\frac{6}{2} = 3 \\)."],"hint":"Write each bracket as a single fraction and watch the cancellation.","image":null,"topic":null,"type":"objective","section":null},{"question":"Change \\( 0.375 \\) to a fraction.","options":["\\( \\dfrac{1}{11} \\)","\\( \\dfrac{3}{8} \\)","\\( \\dfrac{5}{8} \\)","\\( \\dfrac{2}{7} \\)","\\( \\dfrac{4}{9} \\)"],"correctIndex":1,"answer":null,"explanation":["\\( \\frac{375}{1000} = \\frac{3}{8} \\)."],"hint":"\\( 0.375 = \\frac{375}{1000} \\).","image":null,"topic":null,"type":"objective","section":null},{"question":"Evaluate \\( 3^4 - 2^6 \\)","options":["\\( 17 \\)","\\( 19 \\)","\\( 21 \\)","\\( 22 \\)","\\( 24 \\)"],"corr