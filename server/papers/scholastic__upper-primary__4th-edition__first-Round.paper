{"timeLimit":2400,"questions":[{"question":"Express \\(1941\\) in Roman numerals.","options":["MXCI","MXX","MXCXLI","MCMIVI","MCMXLI"],"correctIndex":4,"answer":null,"accept":null,"explanation":["\\(1941 = 1000 + 900 + 40 + 1\\) = M + CM + XL + I = MCMXLI."],"hint":"1000 + 900 + 40 + 1.","image":null,"topic":"Roman Numerals","type":"objective","section":null},{"question":"Express Eleven thousand and one in figures.","options":["\\(110001\\)","\\(11001\\)","\\(101101\\)","\\(11010\\)","\\(1101\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["\\(11\\,000 + 1 = 11\\,001\\)."],"hint":"Eleven thousand is 11 000.","image":null,"topic":"Place Value","type":"objective","section":null},{"question":"Write in words: \\(10179\\).","options":["One hundred and seventy-nine","Ten thousand and one seven nine","Ten thousand seven hundred and nine","Ten thousand, One hundred and seventy-nine","One hundred and one thousand and seven nine"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(10\\,179\\) = ten thousand, one hundred and seventy-nine."],"hint":"Split it as 10 thousand and 179.","image":null,"topic":"Place Value","type":"objective","section":null},{"question":"How many halves \\((1\\tfrac{1}{2})\\) are contained in \\(7\\) wholes?","options":["\\(1\\)","\\(3\\tfrac{1}{2}\\)","\\(4\\tfrac{2}{3}\\)","\\(7\\tfrac{3}{4}\\)","\\(14\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(7 \\div 1\\tfrac{1}{2} = 7 \\times \\frac{2}{3} = \\frac{14}{3} = 4\\tfrac{2}{3}\\).","(If the paper meant halves \\(\\frac{1}{2}\\), the count would be \\(14\\).)"],"hint":"Divide 7 by 1½.","image":null,"topic":"Fractions","type":"objective","section":null},{"question":"\\(25\\) added to a number makes it a quarter of a gross. What is the number?","options":["\\(11\\)","\\(20\\)","\\(36\\)","\\(48\\)","\\(9\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["A quarter of a gross \\(= 144 \\div 4 = 36\\).","\\(36 - 25 = 11\\)."],"hint":"A gross is 144.","image":null,"topic":"Number","type":"objective","section":null},{"question":"One sextillion is?","options":["\\(1 \\times 10^{9}\\)","\\(1 \\times 10^{12}\\)","\\(1 \\times 10^{15}\\)","\\(1 \\times 10^{18}\\)","\\(1 \\times 10^{21}\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["Million \\(10^{6}\\), billion \\(10^{9}\\), trillion \\(10^{12}\\), quadrillion \\(10^{15}\\), quintillion \\(10^{18}\\), sextillion \\(10^{21}\\)."],"hint":"Million, billion, trillion, quadrillion, quintillion, sextillion: each is 1000 times the last.","image":null,"topic":"Large Numbers","type":"objective","section":null},{"question":"At what speed does a man walk to cover \\(12\\) kilometres in \\(90\\) minutes?","options":["\\(16\\) kph","\\(12\\) kph","\\(8\\) kph","\\(4\\) kph","\\(2\\) kph"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(12 \\div 1.5 = 8\\) km per hour."],"hint":"90 minutes is 1½ hours.","image":null,"topic":"Speed, Distance and Time","type":"objective","section":null},{"question":"If \\(x - 1 = 3x - 7\\), what is the value of \\(x\\)?","options":["\\(0\\)","\\(1\\)","\\(2\\)","\\(3\\)","\\(4\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(-1 + 7 = 3x - x\\), so \\(6 = 2x\\) and \\(x = 3\\)."],"hint":"Collect the x terms on one side.","image":null,"topic":"Algebra","type":"objective","section":null},{"question":"Find the HCF of \\(2^{3} \\times 3 \\times 5\\) and \\(2^{2} \\times 3 \\times 7\\).","options":["\\(2^{3} \\times 3 \\times 5 \\times 7\\)","\\(2^{3} \\times 3\\)","\\(2^{5} \\times 3\\)","\\(2^{2} \\times 3\\)","\\(2^{5} \\times 3^{2} \\times 5 \\times 7\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["Common primes: \\(2\\) (lower power \\(2^{2}\\)) and \\(3\\).","HCF \\(= 2^{2} \\times 3\\)."],"hint":"Common primes, to their lower powers.","image":null,"topic":"HCF and LCM","type":"objective","section":null},{"question":"A boy who obtains \\(72\\) marks in a subject gets \\(90\\%\\) of the total marks. What is the full marks of the subject?","options":["\\(60\\)","\\(70\\)","\\(80\\)","\\(90\\)","\\(100\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(72 \\div 0.9 = 80\\)."],"hint":"72 is 90% of the total.","image":null,"topic":"Percentages","type":"objective","section":null,"film":"score-90"},{"question":"Find the circumference of a semi-circle whose diameter is \\(14\\text{ cm}\\). (Take \\(\\pi\\) as \\(\\frac{22}{7}\\).)","options":["\\(22\\text{ cm}\\)","\\(36\\text{ cm}\\)","\\(44\\text{ cm}\\)","\\(134\\text{ cm}^{2}\\)","\\(154\\text{ cm}\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["Curved part \\(= \\frac{1}{2} \\pi d = \\frac{1}{2} \\times \\frac{22}{7} \\times 14 = 22\\text{ cm}\\).","Add the diameter: \\(22 + 14 = 36\\text{ cm}\\).","(The curved part alone is \\(22\\) cm, option A.)"],"hint":"The distance round a semicircle is the curved part plus the diameter.","image":null,"topic":"Circles","type":"objective","section":null},{"question":"At what rate per annum will the interest on \\(£450\\) become \\(£135\\) in \\(1\\) year \\(3\\) months?","options":["\\(12\\%\\)","\\(15\\%\\)","\\(24\\%\\)","\\(25\\%\\)","\\(36\\%\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(R = \\frac{100 \\times I}{P \\times T} = \\frac{100 \\times 135}{450 \\times 1.25} = 24\\%\\)."],"hint":"1 year 3 months is 1¼ years.","image":null,"topic":"Simple Interest","type":"objective","section":null},{"question":"If \\(\\frac{3}{5}\\) of a number is removed from \\(\\frac{5}{6}\\) of the same number, the result is \\(21\\). Find the number.","options":["\\(21\\)","\\(30\\)","\\(40\\)","\\(72\\)","\\(90\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["\\(\\frac{5}{6} - \\frac{3}{5} = \\frac{25 - 18}{30} = \\frac{7}{30}\\).","\\(\\frac{7}{30}\\) of the number \\(= 21\\), so the number \\(= 90\\)."],"hint":"Find 5/6 − 3/5 first.","image":null,"topic":"Fractions","type":"objective","section":null},{"question":"Which is the smallest number which \\(4\\), \\(5\\) and \\(6\\) will divide with a remainder of \\(3\\)?","options":["\\(122\\)","\\(63\\)","\\(60\\)","\\(18\\)","\\(15\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["LCM of \\(4, 5, 6 = 60\\).","\\(60 + 3 = 63\\)."],"hint":"Find the LCM, then add the remainder.","image":null,"topic":"HCF and LCM","type":"objective","section":null},{"question":"Laura sold a shirt at the rate of \\(₦1200\\) and made a profit of \\(20\\%\\). What was the cost price?","options":["\\(₦240\\)","\\(₦480\\)","\\(₦960\\)","\\(₦1000\\)","\\(₦1180\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(1200 \\div 1.2 = ₦1000\\)."],"hint":"The selling price is 120% of the cost price.","image":null,"topic":"Profit and Loss","type":"objective","section":null,"film":"profit-20"},{"question":"If \\(a^{\\circ} + b^{\\circ} + c^{\\circ} = y^{\\circ}\\), what is the value of \\(\\frac{1}{9}y^{\\circ}\\)?","options":["\\(360^{\\circ}\\)","\\(270^{\\circ}\\)","\\(180^{\\circ}\\)","\\(90^{\\circ}\\)","\\(40^{\\circ}\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["\\(a + b + c = 360^{\\circ}\\), so \\(y = 360\\).","\\(\\frac{1}{9} \\times 360^{\\circ} = 40^{\\circ}\\)."],"hint":"Angles round a point add up to 360°.","image":"/exam-archive/competitions/scholastic/upper-primary/4th-edition/first-Round/q16.svg","topic":"Angles","type":"objective","section":null},{"question":"The sum of the angles in a pentagon is equal to?","options":["\\(1260^{\\circ}\\)","\\(720^{\\circ}\\)","\\(540^{\\circ}\\)","\\(360^{\\circ}\\)","\\(180^{\\circ}\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\((5 - 2) \\times 180^{\\circ} = 540^{\\circ}\\)."],"hint":"Use (n − 2) × 180°.","image":null,"topic":"Polygons","type":"objective","section":null},{"question":"Simplify \\(3 - 20 \\div 4 + 27\\).","options":["\\(1\\)","\\(6\\)","\\(14\\)","\\(25\\)","\\(30\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(20 \\div 4 = 5\\); \\(3 - 5 + 27 = 25\\)."],"hint":"Divide first.","image":null,"topic":"Order of Operations","type":"objective","section":null},{"question":"A water container \\(3\\text{ m}\\) long and \\(2\\text{ m}\\) wide holds \\(16.2\\text{ m}^{3}\\) of water. Its height is","options":["\\(2.7\\text{ m}\\)","\\(3.3\\text{ m}\\)","\\(4.5\\text{ m}\\)","\\(5.2\\text{ m}\\)","\\(16.8\\text{ m}\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(16.2 = 3 \\times 2 \\times h\\), so \\(h = 2.7\\text{ m}\\)."],"hint":"Volume = length × width × height.","image":null,"topic":"Mensuration","type":"objective","section":null},{"question":"Taiwo, Kehinde and Idowu are to share \\(\\$600\\) in the ratio \\(3:2:1\\) respectively. What is Idowu's share?","options":["\\(\\$600\\)","\\(\\$800\\)","\\(\\$100\\)","\\(\\$300\\)","\\(\\$16\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(3 + 2 + 1 = 6\\) parts; Idowu gets \\(\\frac{1}{6}\\) of \\(\\$600 = \\$100\\)."],"hint":"There are 6 parts in all.","image":null,"topic":"Ratio","type":"objective","section":null},{"question":"Find the value of \\(5\\tfrac{1}{2}\\%\\) of \\(\\$1200\\).","options":["\\(66\\)","\\(80\\)","\\(100\\)","\\(132\\)","\\(144\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(5.5 \\times 12 = 66\\)."],"hint":"1% of 1200 is 12.","image":null,"topic":"Percentages","type":"objective","section":null},{"question":"The diagram below shows \\(3\\) angles on a straight line. Find \\(x\\).","options":["\\(6\\)","\\(8\\)","\\(10\\)","\\(12\\)","\\(15\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["\\(60 + 5x + 3x = 180\\), so \\(8x = 120\\) and \\(x = 15\\)."],"hint":"Angles on a straight line add up to 180°.","image":"/exam-archive/competitions/scholastic/upper-primary/4th-edition/first-Round/q22.svg","topic":"Angles","type":"objective","section":null},{"question":"In the diagram, the percentage of small squares that are not shaded is?","options":["\\(9\\%\\)","\\(33\\%\\)","\\(36\\%\\)","\\(56.25\\%\\)","\\(64\\%\\)"],"correctIndex":4,"answer":null,"accept":null,"explanation":["The grid has \\(5 \\times 5 = 25\\) small squares; \\(9\\) are shaded.","Not shaded: \\(16\\) of \\(25\\) \\(= 64\\%\\)."],"hint":"Count the small squares and the shaded ones.","image":"/exam-archive/competitions/scholastic/upper-primary/4th-edition/first-Round/q23.svg","topic":"Percentages","type":"objective","section":null},{"question":"How many weeks are in \\(1680\\) hours?","options":["\\(6\\)","\\(8\\)","\\(10\\)","\\(12\\)","\\(16\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(7 \\times 24 = 168\\) hours in a week.","\\(1680 \\div 168 = 10\\) weeks."],"hint":"A week has 7 × 24 hours.","image":null,"topic":"Time","type":"objective","section":null},{"question":"The heights of three trees are \\(0.41\\text{ m}\\), \\(2.10\\text{ m}\\) and \\(3.52\\text{ m}\\). Find their average height.","options":["\\(3.01\\text{ m}\\)","\\(2.10\\text{ m}\\)","\\(2.04\\text{ m}\\)","\\(2.01\\text{ m}\\)","\\(1.07\\text{ m}\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(0.41 + 2.10 + 3.52 = 6.03\\); \\(6.03 \\div 3 = 2.01\\text{ m}\\)."],"hint":"Add, then divide by 3.","image":null,"topic":"Averages","type":"objective","section":null},{"question":"Find the value of \\(t\\) if \\(\\frac{t}{3} + 4 = 23\\).","options":["\\(57\\)","\\(45\\)","\\(30\\)","\\(27\\)","\\(19\\)"],"correctIndex":0,"answer":null,"accept":null,"explanation":["\\(\\frac{t}{3} = 19\\), so \\(t = 57\\)."],"hint":"Take away 4, then multiply by 3.","image":null,"topic":"Algebra","type":"objective","section":null},{"question":"What is the value of the missing number in: \\(30, 21, ?, 9, 6, 5\\)?","options":["\\(19\\)","\\(17\\)","\\(14\\)","\\(13\\)","\\(11\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["The differences are \\(9, 7, 5, 3, 1\\).","\\(21 - 7 = 14\\), then \\(14 - 5 = 9\\)."],"hint":"Look at the differences.","image":null,"topic":"Sequences","type":"objective","section":null},{"question":"Find the surface area of a cube \\(6\\text{ cm}\\) in length.","options":["\\(36\\text{ cm}^{2}\\)","\\(64\\text{ cm}^{2}\\)","\\(120\\text{ cm}^{2}\\)","\\(216\\text{ cm}^{2}\\)","\\(252\\text{ cm}^{2}\\)"],"correctIndex":3,"answer":null,"accept":null,"explanation":["\\(6 \\times 6^{2} = 216\\text{ cm}^{2}\\)."],"hint":"6 faces, each a square.","image":null,"topic":"Mensuration","type":"objective","section":null},{"question":"If \\(7\\) boys can do a piece of work in \\(18\\) days, how many extra boys will be needed to do the same work in \\(6\\) days at the same rate?","options":["\\(7\\)","\\(14\\)","\\(17\\)","\\(18\\)","\\(21\\)"],"correctIndex":1,"answer":null,"accept":null,"explanation":["Work \\(= 7 \\times 18 = 126\\) boy-days; in \\(6\\) days it needs \\(21\\) boys.","Extra boys \\(= 21 - 7 = 14\\)."],"hint":"Find how many boys are needed in all, then subtract 7.","image":null,"topic":"Variation","type":"objective","section":null},{"question":"Round off \\(754.08905\\) to \\(2\\) decimal places.","options":["\\(754\\)","\\(7.54\\)","\\(754.09\\)","\\(754.10\\)","\\(7540.89\\)"],"correctIndex":2,"answer":null,"accept":null,"explanation":["\\(754.08|905\\): the next digit is \\(9\\), so round up to \\(754.09\\)."],"hint":"Look at the third decimal place.","image":null,"topic":"Approximation","type":"objective","section":null},{"question":"OjoArome, in preparing for Scholastic Maths fourth edition, solves past competition questions every \\(5\\) days and has a general preparatory class every \\(7\\) days. In the next \\(217\\) days, how many times will he do both on the same days?","options":[],"correctIndex":null,"answer":"\\(6\\) times","accept":["6 times"],"explanation":["Both happen every LCM\\((5, 7) = 35\\) days.","\\(217 \\div 35 = 6.2\\), so \\(6\\) times."],"hint":"","image":null,"topic":"HCF and LCM","type":"subjective","section":null},{"question":"Ronaldo is thinking of two whole numbers. Their product is \\(144\\) and their sum is \\(25\\). What is the smaller number?","options":[],"correctIndex":null,"answer":"\\(9\\)","accept":["9"],"explanation":["\\(9 \\times 16 = 144\\) and \\(9 + 16 = 25\\).","The smaller number is \\(9\\)."],"hint":"","image":null,"topic":"Number Puzzles","type":"subjective","section":null},{"question":"How many litres of \\(10\\%\\) salt solution must be added to \\(5\\) litres of \\(25\\%\\) salt solution to obtain a \\(15\\%\\) salt solution?","options":[],"correctIndex":null,"answer":"\\(10\\) litres","accept":["10 litres"],"explanation":["Salt: \\(0.1x + 0.25 \\times 5 = 0.15(x + 5)\\).","\\(0.1x + 1.25 = 0.15x + 0.75\\), so \\(0.05x = 0.5\\) and \\(x = 10\\) litres."],"hint":"","image":null,"topic":"Mixtures","type":"subjective","section":null},{"question":"The digits \\(2, 0, 5, 9\\) and \\(7\\) are each used once to form the greatest possible odd five-digit number. The digit in the tens place is?","options":[],"correctIndex":null,"answer":"\\(0\\)","accept":["0"],"explanation":["To be odd it must end in \\(5\\), \\(7\\) or \\(9\\); ending in the smallest odd digit, \\(5\\), keeps the big digits in front.","The number is \\(97205\\); its tens digit is \\(0\\)."],"hint":"","image":null,"topic":"Place Value","type":"subjective","section":null},{"question":"\\(10\\text{ cm}\\) and \\(24\\text{ cm}\\) are the measures of the diagonals of a rhombus. Therefore, the length of each side of the rhombus is","options":[],"correctIndex":null,"answer":"\\(13\\text{ cm}\\)","accept":["13 cm"],"explanation":["The diagonals bisect each other at right angles: half-diagonals \\(5\\) cm and \\(12\\) cm.","Side \\(= \\sqrt{5^{2} + 12^{2}} = \\sqrt{169} = 13\\text{ cm}\\)."],"hint":"","image":null,"topic":"Pythagoras","type":"subjective","section":null},{"question":"How much time is there between 11:55 p.m. on Tuesday and 7:33 a.m. on Thursday?","options":[],"correctIndex":null,"answer":"\\(31\\) hours \\(38\\) minutes","accept":["31 hours 38 minutes"],"explanation":["11:55 p.m. Tuesday to 11:55 p.m. Wednesday is \\(24\\) hours.","11:55 p.m. Wednesday to 7:33 a.m. Thursday is \\(7\\) hours \\(38\\) minutes.","Total \\(31\\) hours \\(38\\) minutes."],"hint":"","image":null,"topic":"Time","type":"subjective","section":null},{"question":"Mr Kola received a container of fresh eggs. He sold \\(\\frac{1}{6}\\) of the eggs in the morning and sold another \\(42\\) eggs in the afternoon. At the end of the day, he found that \\(\\frac{3}{4}\\) of the eggs were not sold. How many eggs did he receive in the beginning?","options":[],"correctIndex":null,"answer":"\\(504\\)","accept":["504"],"explanation":["Afternoon fraction \\(= 1 - \\frac{1}{6} - \\frac{3}{4} = \\frac{1}{12}\\).","\\(\\frac{1}{12}\\) of the eggs \\(= 42\\), so he received \\(504\\) eggs."],"hint":"","image":null,"topic":"Fractions","type":"subjective","section":null},{"question":"Chelsea Football Club played \\(33\\) home games this year. They had \\(5\\) losses and \\(21\\) wins. How many games did they tie?","options":[],"correctIndex":null,"answer":"\\(7\\)","accept":["7"],"explanation":["\\(33 - 5 - 21 = 7\\)."],"hint":"","image":null,"topic":"Basic Arithmetic","type":"subjective","section":null},{"question":"What is the minor angle between the hour and minute hand of a clock when it is 11:35?","options":[],"correctIndex":null,"answer":"\\(137.5^{\\circ}\\)","accept":["137.5°"],"explanation":["Hour hand: \\(11 \\times 30 + 35 \\times 0.5 = 347.5^{\\circ}\\); minute hand: \\(35 \\times 6 = 210^{\\circ}\\).","Difference \\(= 137.5^{\\circ}\\), which is the minor angle."],"hint":"","image":null,"topic":"Clock Angles","type":"subjective","section":null},{"question":"In a toss of two coins, what is the probability of getting two heads?","options":[],"correctIndex":null,"answer":"\\(\\frac{1}{4}\\)","accept":["1/4"],"explanation":["The outcomes are HH, HT, TH, TT; one of the four is two heads.","Probability \\(= \\frac{1}{4}\\)."],"hint":"","image":null,"topic":"Probability","type":"subjective","section":null}]}